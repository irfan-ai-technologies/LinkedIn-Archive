# =============================================================================
# LinkedIn Archive — environment variables
# =============================================================================
# Copy this file to `.env` for local development. NEVER commit `.env`.
# In GitHub Actions, set these as repository/environment Secrets instead.
# =============================================================================

# --- LinkedIn OAuth 2.0 (only required if sync.provider = "linkedin") -------
# Create an app at https://www.linkedin.com/developers/apps and request the
# "Share on LinkedIn" / member social read products. Reading a member's own
# posts requires LinkedIn's restricted member-social-read permissions
# (e.g. r_member_social), which require LinkedIn's approval. See
# docs/linkedin-api.md for the full walkthrough.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# Populated automatically by `linkedin-archive auth login` and consumed by
# the sync command. Do not edit by hand; do not commit the file this points
# to (it lives outside the repo by default).
LINKEDIN_TOKEN_STORE=.secrets/linkedin_token.json

# --- Site overrides (optional) ----------------------------------------------
# Any of these override the matching value in config.yaml, useful for
# per-environment deployments (e.g. a staging URL in CI).
# LINKEDIN_ARCHIVE_SITE_URL=https://example.github.io/linkedin-archive

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
